# Copy this file to .env and fill in real values.
# NEVER commit .env — it's already gitignored (see ../.gitignore).

# Required before the EvoLink provider (server/providers/evolink/) can be
# used. Get one from https://evolink.ai/dashboard/keys.
#
# As of Stage 6, no key has been created or requested yet — this file
# exists only so the system is ready for one when that time comes.
EVOLINK_API_KEY=

# Media Acquisition (server/services/media-acquisition-service.js) — free
# stock-image/stock-video providers. Either or both may be left blank: a
# provider with no key configured is simply reported as unavailable
# (structured MISSING_CREDENTIAL result / excluded from
# listAvailableProviders()), never a crash. Get a free key from
# https://www.pexels.com/api/ and https://pixabay.com/api/docs/.
PEXELS_API_KEY=
PIXABAY_API_KEY=
