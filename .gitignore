node_modules/
.env
dist/
out/
*.log

# Real project data created while running the server locally.
# The folder itself is kept in git via .gitkeep; only the generated
# per-project JSON files are ignored.
server/data/projects/*.json
server/data/generation-jobs/*.json
server/data/creative/*.json
server/data/keyframes/*.json
server/data/keyframe-prompt-packages/*.json
server/data/keyframe-generation-approvals/*.json
server/data/keyframe-handoffs/*.json
server/data/identity-consistency-reviews/*.json
server/data/video-prompt-packages/*.json
server/data/video-generation-approvals/*.json
server/data/broll/*.json

# INT-1/INT-2 — video-intelligence pipeline data (real acquired reference
# videos, derived measurements/observations/interpretations/patterns/
# recommendations/blueprints). Same convention as every other data dir
# above: the folder itself is kept in git via .gitkeep; the generated
# per-project JSON is never committed (real scraped/derived content).
server/data/reference-videos/*.json
server/data/reference-video-measurements/*.json
server/data/reference-video-observations/*.json
server/data/reference-video-interpretations/*.json
server/data/reference-video-interpretation-approvals/*.json
server/data/reference-sets/*.json
server/data/cross-video-patterns/*.json
server/data/recommendations/*.json
server/data/creative-blueprints/*.json

# INT-2.5 — pre-production gate results. Same convention: folder kept via
# .gitkeep, generated per-project JSON never committed. P0 Hardening data-
# integrity check found this directory was missing from .gitignore since
# INT-2.5 introduced it — fixed here rather than left as a latent gap that
# could silently commit real dev-server data on a future commit.
server/data/pre-production-gates/*.json

# Downloaded/archived asset files (Stage 9A) — never committed. The folder
# itself is kept in git via .gitkeep.
server/data/assets/*
!server/data/assets/.gitkeep

# Stage 26.9B — local voice-generation/alignment infrastructure (espeak-ng
# is an OS package, not a repo file; the Python venv and downloaded Whisper
# model weights are large, binary, and machine-specific). Ephemeral,
# container-scoped exactly like Stage 26.8B-R's FFmpeg install — must be
# re-provisioned in a fresh environment (see services/voice/README or the
# Stage 26.9B final report for the exact setup commands).
server/.venv/
server/.whisper-models/
