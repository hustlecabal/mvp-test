node_modules/
.env
dist/
out/
*.log

# Real project data created while running the server locally.
# The folder itself is kept in git via .gitkeep; only the generated
# per-project JSON files are ignored.
server/data/projects/*.json
server/data/generation-jobs/*.json
server/data/creative/*.json
server/data/keyframes/*.json

# Downloaded/archived asset files (Stage 9A) — never committed. The folder
# itself is kept in git via .gitkeep.
server/data/assets/*
!server/data/assets/.gitkeep
